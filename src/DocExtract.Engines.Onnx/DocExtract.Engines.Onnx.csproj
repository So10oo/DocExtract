<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>DocExtract.Engines.Onnx</RootNamespace>
    <Description>Локальный OCR-движок DocExtract на ONNX Runtime (PP-OCR, CPU и DirectML).</Description>
    <PackageId>DocExtract.Engines.Onnx</PackageId>
    <PackageTags>ocr;onnx;paddleocr;ppocr</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <ProjectReference Include="..\DocExtract\DocExtract.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.ML.OnnxRuntime.DirectML" Version="1.24.1" />
    <PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
    <PackageReference Include="RapidOCRSharpOnnx" Version="1.3.1" />
  </ItemGroup>
</Project>
